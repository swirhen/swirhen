[Unit]
Description=Torrent Feed Admin API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=swirhen
Group=swirhen
WorkingDirectory=/home/swirhen/sh/checker/torrentsearch/web
ExecStart=/home/swirhen/sh/checker/torrentsearch/web/.venv/bin/uvicorn api:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
